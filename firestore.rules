rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on portfolio collections and documents
    // Only authenticated users (admins) can create, update, or delete
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
