rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the request originates from the verified admin (poosala15@gmail.com)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email == 'poosala15@gmail.com';
    }

    // Allow public read on portfolio collections and documents
    // Only the authorized admin (poosala15@gmail.com) can create, update, or delete
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

